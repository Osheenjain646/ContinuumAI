# Required: NextAuth session signing secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-random-secret

# Required: MongoDB Atlas or self-hosted MongoDB connection string.
# Example: mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=continuumai

# Required for AI dossier synthesis and chat.
GEMINI_API_KEY=your-google-gemini-api-key

# Optional fallbacks for the legacy standalone GitHub and Slack API routes.
# Per-user integrations should normally be configured in the app's Integrations page.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
